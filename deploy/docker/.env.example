# Address players use to reach the server: 127.0.0.1 (this PC only), LAN IP or public IP/domain
PUBLIC_HOST=127.0.0.1
# Port of the website in the browser
WEB_PORT=80
# Game socket port and websocket bridge port (must be reachable by players too)
GAME_PORT=9500
WS_PORT=9501
# SQL Server "sa" password (>= 8 chars, upper + lower case + digit/symbol)
DB_PASSWORD=Ddtank@2024
# Shared secret between the portal and the game API
LOGIN_KEY=ddtank41-change-me
# Ruffle log level in the browser console: error | warn | info | debug
RUFFLE_LOG_LEVEL=error

# --- Gameplay (PvP-focused server) ---
# true: skip the newbie tutorial; every building (game room, shop...) is open from level 1
SKIP_NEWBIE_GUIDE=true
# false: PvP rooms are only matched against other players' rooms (no bot opponents)
PVP_AUTO_BOT=false
# xu (Money) and vàng (Gold) each new character starts with, to buy weapons and fight props
STARTING_MONEY=1000000
STARTING_GOLD=1000000
