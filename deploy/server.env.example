# Copy to deploy/server.env and edit. Used by deploy/configure.py and docker-compose.

# SQL Server (the 3 databases restored from Database/*.bak)
DB_HOST=127.0.0.1,1433
DB_USER=sa
# SQL Server on Linux/Docker requires a strong password (>= 8 chars, upper+lower+digit/symbol)
DB_PASSWORD=Ddtank@2024
DB_PLAYER=Project_Player34
DB_GAME=Project_Game34
DB_MEMBERSHIP=Db_Membership

# Address players use to reach this machine (LAN IP, public IP or domain name).
# Use 127.0.0.1 if you only play on this computer.
PUBLIC_HOST=127.0.0.1

# HTTP port of the web site (flash client + Request handlers)
WEB_PORT=80
# Port players use in the browser if it differs from WEB_PORT (port mapping / reverse proxy); empty = WEB_PORT
PUBLIC_WEB_PORT=
# Game server (Road) TCP port and the WebSocket bridge port used by the browser client (Ruffle)
GAME_PORT=9500
WS_PORT=9501

# Key used by the website to sign logins for the game server (must match on both sides)
LOGIN_KEY=ddtank41-change-me

# Ruffle console log level in the browser: error | warn | info | debug
RUFFLE_LOG_LEVEL=error

# --- Gameplay (PvP-focused server) ---
# true: skip the newbie tutorial; every building (game room, shop...) is open from level 1
SKIP_NEWBIE_GUIDE=true
# false: PvP rooms are only matched against other players' rooms (no bot opponents)
PVP_AUTO_BOT=false
# xu (Money) and vàng (Gold) each new character starts with, to buy weapons and fight props
STARTING_MONEY=1000000
STARTING_GOLD=1000000
